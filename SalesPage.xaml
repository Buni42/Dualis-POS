<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="DualisPos.SalesPage"
    Title="Satış">

    <Grid
        Padding="30"
        RowDefinitions="Auto,Auto,*,Auto"
        RowSpacing="18">

        <Label
            Grid.Row="0"
            Text="Satış / POS"
            Style="{StaticResource PageTitle}" />


        <Grid
            Grid.Row="1"
            ColumnDefinitions="*,Auto"
            ColumnSpacing="10">

            <Entry
                x:Name="BarcodeEntry"
                Grid.Column="0"
                Placeholder="Barkod okutun veya yazın..." />

            <Button
                Grid.Column="1"
                Text="Ekle"
                WidthRequest="100"
                Style="{StaticResource PrimaryButton}"
                Clicked="AddProductClicked" />

        </Grid>


        <Border
            Grid.Row="2"
            Style="{StaticResource CardBorder}">

            <VerticalStackLayout>

                <Label
                    Text="Sepet"
                    FontSize="20"
                    FontAttributes="Bold" />

                <CollectionView
                    ItemsSource="{Binding Basket}"
                    Margin="0,15,0,0">

                    <CollectionView.ItemTemplate>

                        <DataTemplate>

                            <Label
                                Text="{Binding .}"
                                FontSize="16"
                                Padding="5" />

                        </DataTemplate>

                    </CollectionView.ItemTemplate>

                </CollectionView>

            </VerticalStackLayout>

        </Border>


        <Button
            Grid.Row="3"
            Text="Satışı Tamamla"
            Style="{StaticResource PrimaryButton}"
            Clicked="CompleteSaleClicked" />

    </Grid>

</ContentPage>
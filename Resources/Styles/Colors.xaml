<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Ana renkler -->
    <Color x:Key="Primary">#0B5FFF</Color>
    <Color x:Key="PrimaryDark">#0849C5</Color>

    <Color x:Key="Secondary">#00C2D7</Color>
    <Color x:Key="SecondaryDark">#008FA0</Color>

    <Color x:Key="Accent">#19D3E6</Color>

    <!-- Arka plan -->
    <Color x:Key="Background">#F4F8FC</Color>
    <Color x:Key="DarkBackground">#08131F</Color>

    <!-- Kart -->
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="DarkSurface">#102131</Color>

    <!-- Yazılar -->
    <Color x:Key="TextPrimary">#102A43</Color>
    <Color x:Key="TextSecondary">#5B7083</Color>

    <!-- Kenarlık -->
    <Color x:Key="Border">#D9E5EF</Color>
    <Color x:Key="DarkBorder">#24384A</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
</ResourceDictionary>
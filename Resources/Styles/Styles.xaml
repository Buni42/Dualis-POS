<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- SAYFA -->

    <Style TargetType="ContentPage">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource Background},
                                        Dark={StaticResource DarkBackground}}" />
    </Style>


    <!-- NORMAL LABEL -->

    <Style TargetType="Label">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextPrimary},
                                        Dark={StaticResource White}}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="15" />
    </Style>


    <!-- BAŞLIK -->

    <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextPrimary},
                                        Dark={StaticResource White}}" />
    </Style>


    <!-- ALT BAŞLIK -->

    <Style x:Key="PageSubtitle" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextSecondary},
                                        Dark=#A9BBCB}" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
    </Style>


    <!-- ENTRY -->

    <Style TargetType="Entry">
        <Setter Property="TextColor"
                Value="{AppThemeBinding Light={StaticResource TextPrimary},
                                        Dark={StaticResource White}}" />
        <Setter Property="PlaceholderColor"
                Value="{AppThemeBinding Light=#8FA2B3,
                                        Dark=#72879A}" />
        <Setter Property="BackgroundColor"
                Value="Transparent" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="MinimumHeightRequest" Value="50" />
    </Style>


    <!-- ANA BUTON -->

    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="MinimumHeightRequest" Value="52" />
        <Setter Property="Padding" Value="18,12" />
    </Style>


    <!-- İKİNCİ BUTON -->

    <Style x:Key="SecondaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Secondary}" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="MinimumHeightRequest" Value="52" />
        <Setter Property="Padding" Value="18,12" />
    </Style>


    <!-- KART -->

    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="BackgroundColor"
                Value="{AppThemeBinding Light={StaticResource Surface},
                                        Dark={StaticResource DarkSurface}}" />

        <Setter Property="Stroke"
                Value="{AppThemeBinding Light={StaticResource Border},
                                        Dark={StaticResource DarkBorder}}" />

        <Setter Property="StrokeThickness" Value="1" />

        <Setter Property="StrokeShape">
            <Setter.Value>
                <RoundRectangle CornerRadius="18" />
            </Setter.Value>
        </Setter>

        <Setter Property="Padding" Value="24" />
    </Style>

</ResourceDictionary>